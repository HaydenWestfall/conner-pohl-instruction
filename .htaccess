# Conner Pohl Instruction — Apache config for Hostinger shared hosting.
#
# Copied into dist/ by the deploy workflow (it lives outside Vite's publicDir,
# so it is not part of the build output on its own).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host and scheme -------------------------------------------
  # Every page must be reachable at exactly one URL or the same content gets
  # indexed two or three times over. Force HTTPS and drop the www prefix.
  #
  # Both conditions are required: Hostinger terminates TLS at a proxy, so on
  # some plans %{HTTPS} is never "on" even for an HTTPS request. Checking
  # X-Forwarded-Proto as well is what keeps this from becoming a redirect loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://connerpohlinstruction.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # --- Prerendered route pages ---------------------------------------------
  # The build writes dist/about/index.html, dist/faq/index.html, and so on,
  # each with its own title, description, canonical, and JSON-LD. Serve those
  # directly so crawlers and social scrapers get real per-page metadata.
  #
  # This is an internal rewrite rather than a redirect, so /about stays /about
  # in the address bar and no extra round trip is added.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # --- SPA fallback ---------------------------------------------------------
  # Anything else that is not a real file falls through to the app shell, which
  # renders the client-side 404 route.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Unknown URLs return a real 404 status with a noindex page, instead of the
# 200-with-app-shell soft 404 that search engines will happily index.
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE application/rss+xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # HTML is NOT fingerprinted. Caching it would pin visitors to a stale build
  # and, worse, pin crawlers to stale metadata.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # `Header` belongs to mod_headers, so these directives live here rather than
  # in the mod_expires block above — inside that guard they would 500 on a host
  # that has mod_expires enabled but not mod_headers.
  #
  # Vite fingerprints asset filenames, so these can be cached indefinitely: a
  # content change produces a new filename.
  <FilesMatch "\.(js|css|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>
