{
  "name": "conner-pohl-instruction",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Professional baseball instruction and training website for CPI Baseball in Troy, OH",
  "author": "Hayden Westfall",
  "homepage": "https://connerpohlinstruction.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaydenWestfall/conner-pohl-instruction.git"
  },
  "keywords": [
    "baseball",
    "instruction",
    "training",
    "react",
    "typescript",
    "sports",
    "coaching",
    "ohio"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite --mode development --host",
    "dev": "vite --host",
    "dev:prod": "vite --mode production --host",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "lenis": "^1.3.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.1",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.6",
    "vite-plugin-svgr": "^4.3.0"
  }
}
