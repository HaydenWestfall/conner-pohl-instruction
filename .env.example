# External booking system URL
VITE_BOOKING_URL=https://your-booking-system.com

# Google Maps location link
VITE_GOOGLE_MAPS_URL=https://maps.google.com/your-location

# Social media URLs
VITE_FACEBOOK_URL=https://facebook.com/your-page
VITE_INSTAGRAM_URL=https://instagram.com/your-profile
VITE_TIKTOK_URL=https://tiktok.com/@your-username

# Contact API base URL — origin only, NO path.
# ContactForm appends "/api/contact" itself, so a value that already ends in
# /api/contact produces .../api/contact/api/contact and the form silently 404s.
VITE_CONTACT_API_URL=https://your-contact-api.com
